# Copy this file to env.local.ps1 and adjust values before running start-proxy.ps1.
# Only use this reverse proxy for websites/systems you own or are authorized to administer.

$TargetScheme = "https"
$TargetHost = "example.internal"
$ListenPort = 8080

# Optional: set this if auto-detection chooses the wrong LAN address.
# $BindIp = "192.168.1.10"

# Optional: comma-separated absolute origins that appear in HTML/JS/CSS responses
# and should be rewritten to the LAN proxy origin. Include API/CDN origins that are
# owned by the same authorized application if frontend code calls them directly.
$RewriteOrigins = @(
  "https://example.internal",
  "http://example.internal"
)

# Optional: path to nginx.exe. If empty, start-proxy.ps1 checks tools\nginx\nginx.exe,
# .\nginx\nginx.exe, and PATH.
# $NginxExe = "C:\\nginx\\nginx.exe"
