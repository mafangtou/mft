#
# Security note: this configuration is intended for authorized internal reverse
# proxying of applications you own/administer. It is not a tool for bypassing
# third-party access controls.

worker_processes  1;
error_log  __LOG_DIR__/nginx-error.log info;
pid        __RUN_DIR__/nginx.pid;

events {
    worker_connections  1024;
}

http {
    __MIME_TYPES_BLOCK__
    default_type  application/octet-stream;

    access_log  __LOG_DIR__/nginx-access.log;
    sendfile    on;
    keepalive_timeout 65;

    # Needed so sub_filter can rewrite compressed upstream pages.
    gzip off;

    map $http_upgrade $proxy_upgrade {
        default $http_upgrade;
        ""      "";
    }

    map $http_upgrade $proxy_connection {
        default "upgrade";
        ""      "close";
    }

    server {
        listen __BIND_IP__:__LISTEN_PORT__;
        server_name __BIND_IP__;

        # Basic diagnostics endpoint for startup checks.
        location = /__proxy_health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "ok\n";
        }

        location / {
            proxy_pass __TARGET_SCHEME__://__TARGET_HOST__;
            proxy_http_version 1.1;

            # Mandatory host/header normalization for authorized reverse proxying.
            proxy_set_header Host __TARGET_HOST__;
            proxy_set_header SNI __TARGET_HOST__;
            proxy_ssl_server_name on;
            proxy_ssl_name __TARGET_HOST__;

            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Referer __TARGET_SCHEME__://__TARGET_HOST__/;

            # Preserve browser compatibility while reducing accidental variation
            # in outbound headers. Do not use this to impersonate users or bypass
            # third-party anti-abuse systems.
            proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36";
            proxy_set_header Accept $http_accept;
            proxy_set_header Accept-Language "zh-CN,zh;q=0.9,en;q=0.8";
            proxy_set_header Cookie $http_cookie;

            proxy_set_header Upgrade $proxy_upgrade;
            proxy_set_header Connection $proxy_connection;

            proxy_connect_timeout 30s;
            proxy_send_timeout 120s;
            proxy_read_timeout 120s;

            # Response body rewrite: keep browser-side absolute URLs inside the
            # LAN reverse proxy so API calls do not bypass the proxy.
            proxy_set_header Accept-Encoding "";
            sub_filter_once off;
            sub_filter_types text/html text/css text/xml text/plain application/javascript application/json application/xml;
__SUB_FILTER_RULES__

            # Rewrite upstream redirects and cookie domains back to the LAN proxy.
            proxy_redirect __TARGET_SCHEME__://__TARGET_HOST__/ http://__BIND_IP__:__LISTEN_PORT__/;
            proxy_cookie_domain __TARGET_HOST__ __BIND_IP__;
            proxy_cookie_path / /;
        }
    }
}
